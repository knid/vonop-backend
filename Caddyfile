{
    # Admin API reachable on the docker compose network so the api/worker
    # containers can post /load reload requests. Bound to 0.0.0.0 because
    # clients reach it via the docker service name (http://caddy:2019), not
    # loopback. Port 2019 is NOT published in docker-compose.yaml, so it is
    # only reachable inside the compose network — keep it that way. As
    # defense-in-depth, `origins` + `enforce_origin` restricts which Host
    # headers the admin API will accept, so only the api/worker services can
    # mutate config even if another container on the bridge tries to.
    admin 0.0.0.0:2019 {
        origins caddy:2019 api:2019 worker:2019 localhost:2019
        enforce_origin
    }

    # On-demand TLS for custom user domains (file-imported below). Caddy
    # asks the api backend before issuing each Let's Encrypt cert.
    on_demand_tls {
        ask http://api:8001/internal/edge/cert-allowed
    }
}

api.wemob.io {
    encode zstd gzip

    handle {
        reverse_proxy api:8001
        
        header {
            Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
            X-Content-Type-Options "nosniff"
            X-Frame-Options "DENY" 
            Referrer-Policy "no-referrer-when-downgrade"
        }
    }

    log {
        output file /var/log/caddy/api_access.log
        format console
    }
}

mcp.wemob.io {
    encode zstd gzip

    handle /.well-known/* {
        reverse_proxy api:8001
    }

    handle /oauth/* {
        reverse_proxy api:8001
    }

    handle /mcp* {
        reverse_proxy api:8001
    }

    handle {
        rewrite * /mcp
        reverse_proxy api:8001
    }

    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
        X-Content-Type-Options "nosniff"
        X-Frame-Options "DENY"
        Referrer-Policy "no-referrer-when-downgrade"
    }

    log {
        output file /var/log/caddy/mcp_access.log
        format console
    }
}

*.preview.wemob.app {
    tls {
        dns cloudflare {env.CF_API_TOKEN}
    }

    rewrite * /internal/preview/proxy?host={host}
    reverse_proxy api:8001 {
        header_up Host {host}
        header_up X-Forwarded-Host {host}
        header_up X-Wemob-Preview-Host {host}
        header_up X-Original-URI {http.request.orig_uri}
        header_up X-Internal-Token {$EDGE_INTERNAL_TOKEN}
    }
}

# Wemob user apps. The backend edge handler serves split-web static assets
# from S3/CDN and proxies legacy/API traffic to Fly as needed.
*.wemob.app {
    tls {
        dns cloudflare {env.CF_API_TOKEN}
    }

    rewrite * /internal/edge/proxy?host={host}
    reverse_proxy api:8001 {
        header_up Host api.wemob.io
        header_up X-Original-URI {http.request.orig_uri}
        header_up X-Internal-Token {$EDGE_INTERNAL_TOKEN}
    }

    log {
        output file /var/log/caddy/wemob_app_access.log
        format console
    }
}

# Verified custom domains use the same backend edge handler. On-demand TLS asks
# the API before issuing a certificate, so unverified domains are rejected
# before this catch-all route serves traffic.
:443 {
    tls {
        on_demand
    }

    rewrite * /internal/edge/proxy?host={host}
    reverse_proxy api:8001 {
        header_up Host api.wemob.io
        header_up X-Original-URI {http.request.orig_uri}
        header_up X-Internal-Token {$EDGE_INTERNAL_TOKEN}
    }

    log {
        output file /var/log/caddy/custom_domain_access.log
        format console
    }
}
