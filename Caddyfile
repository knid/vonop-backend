{
    # Admin API reachable on the docker compose network so the api/worker
    # containers can post /load reload requests. Bound to 0.0.0.0 because
    # clients reach it via the docker service name (http://caddy:2019), not
    # loopback. Port 2019 is NOT published in docker-compose.yaml, so it is
    # only reachable inside the compose network — keep it that way. As
    # defense-in-depth, `origins` + `enforce_origin` restricts which Host
    # headers the admin API will accept, so only the api/worker services can
    # mutate config even if another container on the bridge tries to.
    admin 0.0.0.0:2019 {
        origins caddy:2019 api:2019 worker:2019 localhost:2019
        enforce_origin
    }

    # On-demand TLS for custom user domains (file-imported below). Caddy
    # asks the api backend before issuing each Let's Encrypt cert.
    on_demand_tls {
        ask https://api.wemob.io/internal/edge/cert-allowed
    }
}

api.wemob.io {
    encode zstd gzip

    handle {
        reverse_proxy api:8001
        
        header {
            Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
            X-Content-Type-Options "nosniff"
            X-Frame-Options "DENY" 
            Referrer-Policy "no-referrer-when-downgrade"
        }
    }

    log {
        output file /var/log/caddy/api_access.log
        format console
    }
}

*.preview.wemob.app {
    tls {
        dns cloudflare {env.CF_API_TOKEN}
    }

    reverse_proxy {
        # versions ipv4: Fly publishes both A and AAAA for *.fly.dev, but the
        # docker host has no IPv6, so dialing the AAAA address fails with
        # "network is unreachable" ~50% of requests.
        dynamic a {
            name {http.request.host.labels.3}.e2b.app
            port 443
            versions ipv4
        }
        transport http {
            tls
            tls_server_name {http.request.host.labels.3}.e2b.app
        }
        header_up Host {http.request.host.labels.3}.e2b.app

        # Sandbox expired (~1h idle) — E2B returns 502 with a JSON body.
        # Swap it for the branded static page from wemob.app so the iframe
        # (and direct visitors to shared preview URLs) get something
        # actionable instead of raw JSON. The static page postMessages the
        # studio parent so the preview UI auto-recovers.
        @sandbox_gone status 502
        handle_response @sandbox_gone {
            header -Content-Type
            rewrite * /sandbox-expired.html
            reverse_proxy https://wemob.app {
                header_up Host wemob.app
            }
        }
    }
}

# Wemob user apps deployed on Fly Machines.
# {slug}.wemob.app → wemob-{slug}.fly.dev via Fly's published A records.
*.wemob.app {
    tls {
        dns cloudflare {env.CF_API_TOKEN}
    }

    reverse_proxy {
        # versions ipv4: see preview block above.
        dynamic a {
            name wemob-{http.request.host.labels.2}.fly.dev
            port 443
            versions ipv4
        }
        transport http {
            tls
            tls_server_name wemob-{http.request.host.labels.2}.fly.dev
        }
        header_up Host wemob-{http.request.host.labels.2}.fly.dev
    }

    log {
        output file /var/log/caddy/wemob_app_access.log
        format console
    }
}

# Custom domains: each verified domain is a separate file written by the api
# backend. Caddy reloads when /load is hit by the backend after a write.
import /etc/caddy/custom-domains/*.caddy