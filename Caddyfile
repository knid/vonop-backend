api.wemob.io {
    encode zstd gzip

    handle {
        reverse_proxy api:8001
        
        header {
            Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
            X-Content-Type-Options "nosniff"
            X-Frame-Options "DENY" 
            Referrer-Policy "no-referrer-when-downgrade"
        }
    }

    log {
        output file /var/log/caddy/api_access.log
        format console
    }
}

*.preview.wemob.app {
    tls {
        dns cloudflare {env.CF_API_TOKEN}
    }

    reverse_proxy {
        dynamic a {http.request.host.labels.3}.e2b.app 443
        transport http {
            tls
            tls_server_name {http.request.host.labels.3}.e2b.app
        }
        header_up Host {http.request.host.labels.3}.e2b.app
    }
}