{
    # On-demand TLS asks our backend before issuing each cert. Without the
    # ask URL, Caddy would happily issue certs for any hostname pointed at us.
    on_demand_tls {
        ask https://api.wemob.io/internal/edge/cert-allowed
        rate_limit 100 1m
    }
    email ops@wemob.io
}

# wemob.app subdomains: pattern-based routing, single wildcard cert.
*.wemob.app {
    tls {
        dns cloudflare {env.CF_API_TOKEN}
    }

    @host header_regexp host Host ^(?P<slug>[^.]+)\.wemob\.app$
    handle @host {
        rewrite * /internal/edge/proxy?host={host}
        reverse_proxy https://api.wemob.io {
            header_up Host api.wemob.io
            header_up X-Original-URI {http.request.orig_uri}
            header_up X-Internal-Token {$EDGE_INTERNAL_TOKEN}
            transport http {
                tls
                tls_server_name api.wemob.io
            }
        }
    }
}

# Custom domains: on-demand TLS, dynamic upstream lookup.
:443 {
    tls {
        on_demand
    }

    rewrite * /internal/edge/proxy?host={host}
    reverse_proxy https://api.wemob.io {
        header_up Host api.wemob.io
        header_up X-Original-URI {http.request.orig_uri}
        header_up X-Internal-Token {$EDGE_INTERNAL_TOKEN}
        transport http {
            tls
            tls_server_name api.wemob.io
        }
    }
}
